# Copy this file to `.env` and adjust. `.env` is git-ignored.
# Every variable below is optional unless marked REQUIRED; the defaults
# shown are the ones the code falls back to.

# ---------------------------------------------------------------
# Backend (Fastify) -- app/backend/src/index.ts
# ---------------------------------------------------------------
# Port the backend HTTP/WebSocket API listens on.
PORT=8717
# Alternative port name honoured by scripts/start.mjs.
BACKEND_PORT=8717
# Interface the backend binds to. Keep it on loopback.
HOST=127.0.0.1

# ---------------------------------------------------------------
# Frontend / tooling
# ---------------------------------------------------------------
# Base URL the frontend and helper scripts use to reach the backend.
ROM_EDITOR_BASE_URL=http://127.0.0.1:8717

# ---------------------------------------------------------------
# Project + toolchain locations (you supply these)
# ---------------------------------------------------------------
# Absolute path to YOUR decompilation project (e.g. a pret/pokefirered
# clone). Passed to the spawned agent as the workspace root. No project
# data ships with this repo.
ROM_EDITOR_PROJECT_ROOT=C:\path\to\pokefirered
# Full path to devkitPro's MSYS2 bash.exe, used by the "Build & Play"
# pipeline. Only needed if it is not at C:\devkitPro\msys2\usr\bin\bash.exe
# or C:\msys64\usr\bin\bash.exe.
ROM_EDITOR_MSYS_BASH=C:\devkitPro\msys2\usr\bin\bash.exe
# Path to the `claude` CLI binary that backs the AI agent panel.
# Leave unset to resolve it from PATH.
CLAUDE_CLI_PATH=claude

# ---------------------------------------------------------------
# Tile-intelligence sidecar (Python, tile-intel-svc/)
# All of its settings use the TILE_INTEL_ prefix (pydantic-settings).
# ---------------------------------------------------------------
# Set to 1 to skip bringing up the Docker Postgres+Qdrant tier and the
# Python sidecar entirely. The editor degrades gracefully without it.
SKIP_TILE_INTEL=0
TILE_INTEL_HOST=127.0.0.1
TILE_INTEL_PORT=58080
TILE_INTEL_LOG_LEVEL=info
# Postgres (docker-compose.yml publishes it on 127.0.0.1:15432).
TILE_INTEL_PG_HOST=127.0.0.1
TILE_INTEL_PG_PORT=15432
TILE_INTEL_PG_USER=tile_intel
TILE_INTEL_PG_DATABASE=tile_intel
# REQUIRED when running docker compose: pick any local password.
TILE_INTEL_PG_PASSWORD=your-postgres-password-here
# Qdrant vector store (docker-compose.yml).
TILE_INTEL_QDRANT_HOST=127.0.0.1
TILE_INTEL_QDRANT_PORT=16333
TILE_INTEL_QDRANT_GRPC_PORT=16334
# Where downloaded CLIP weights are cached.
TILE_INTEL_MODEL_CACHE_DIR=models
# 1 boots the sidecar in test mode (SQLite + FAISS, no model download).
TILE_INTEL_TEST_MODE=0
# Directory uv uses for managed Python installs (optional).
UV_PYTHON_INSTALL_DIR=

# ---------------------------------------------------------------
# Debug
# ---------------------------------------------------------------
# 1 enables verbose logging from the headless mGBA node harness.
MGBA_NODE_DEBUG=0
